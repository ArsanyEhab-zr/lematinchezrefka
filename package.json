    "test": "node tests/run.mjs",
    "test:database": "node tests/database.test.mjs"
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.4",
    "@cloudinary/url-gen": "^1.22.0",
    "@supabase/supabase-js": "2.119.0",
